# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron
.local/

# targets pipeline store — rebuildable, and large
_targets/

# Data. Raw downloads are immutable but big; MANIFEST.json is what makes them
# reproducible, so it is the one thing here that IS tracked.
data/raw/*
!data/raw/MANIFEST.json
data/processed/*
!data/processed/.gitkeep

# Tests retain one immutable IMLS fixture and its provenance, not adapter caches.
tests/testthat/data/raw/*
!tests/testthat/data/raw/2018_csv_museum_data_files.zip
!tests/testthat/data/raw/MANIFEST.json

# Build artifacts: embeds are generated, then deployed to the blog repo.
# Static fallbacks live in the post bundles and ARE tracked.
embeds/*.html
embeds/*.png

# Knitted output
posts/**/*.html
posts/**/index_files/

# Independent church target store; preserve museum targets and labels.
_targets_churches/

# Reproducible static explorer payloads; checksums stay in validation.
dashboard/data/

# Full-table checkpoint snapshots (~22 MB each). Their SHA-256 hashes are recorded
# in later packets' protected_files.csv and the tables replay from tracked decisions,
# so they stay on local disk only. Decisions, evidence and audits remain tracked.
data/validation/*_2026-09-26/proposed_after.csv
data/validation/*_2026-09-26/analysis_after.csv
data/validation/museum_next_leaders_2026-09-26/depot_after.csv
data/validation/museum_next_leaders_2026-09-26/wayne_after.csv
data/validation/artifact_refresh_2026-09-26/unreviewed_institutions.csv
data/validation/church_ordinal_review_2026-09-26/duplicate_counts_after.csv
