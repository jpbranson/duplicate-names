# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron
.local/

# targets pipeline store — rebuildable, and large
_targets/

# Data. Raw downloads are immutable but big; MANIFEST.json is what makes them
# reproducible, so it is the one thing here that IS tracked.
data/raw/*
!data/raw/MANIFEST.json
data/processed/*
!data/processed/.gitkeep

# Tests retain one immutable IMLS fixture and its provenance, not adapter caches.
tests/testthat/data/raw/*
!tests/testthat/data/raw/2018_csv_museum_data_files.zip
!tests/testthat/data/raw/MANIFEST.json

# Build artifacts: embeds are generated, then deployed to the blog repo.
# Static fallbacks live in the post bundles and ARE tracked.
embeds/*.html
embeds/*.png

# Knitted output
posts/**/*.html
posts/**/index_files/
